# Port the bot service listens on
PORT=3001

# Optional shared secret between the frontend and this backend.
# If set, the frontend must send it as the `x-api-key` header.
# CHAT_API_KEY=

# === Future chatbot training / LLM integration ===
# When you train a model (or wire a RAG pipeline), set these and the
# generateReply() function will route to it instead of the rule-based FAQ.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
